# Copy to `.env` and fill in real values BEFORE the first `docker compose up`.
# Field names map to evalbench/config.py (case-insensitive).

# ── MongoDB ──
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=evalbench

# ── Ollama (model under test + LLM judge) ──
OLLAMA_BASE_URL=http://localhost:11434

# ── Hosted providers (all optional, all have free tiers) ──
# provider: groq     -> https://console.groq.com
GROQ_API_KEY=
# provider: gemini   -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
# provider: github   -> a GitHub PAT, https://github.com/settings/tokens
GITHUB_TOKEN=
# provider: openrouter -> https://openrouter.ai/keys
OPENROUTER_API_KEY=
# provider: openai   -> https://platform.openai.com (paid)
OPENAI_API_KEY=

# ── Job queue ──
# inline = run in the API process (no Redis needed; default, used by CI and
#          the GitHub Action).  rq = enqueue to Redis, executed by
#          `python -m evalbench.worker`.  docker compose uses rq.
JOB_BACKEND=inline
# With JOB_BACKEND=rq the runner executes in the worker, so the worker
# serves its own /metrics on this port for Prometheus to scrape. Scraping
# only the API would leave every run metric uncollected.
WORKER_METRICS_PORT=9100
REDIS_URL=redis://localhost:6379/0

# ── Timeouts (seconds) ──
DEFAULT_REQUEST_TIMEOUT=120
SUITE_RUN_TIMEOUT=900

# ── Custom endpoints ──
# A run can name its own OpenAI-compatible endpoint (provider: custom).
# By default only public https hosts are accepted, and the address is
# re-checked when the worker connects. Set this to true ONLY on an
# instance that runs on your own machine and should reach a model
# server on your own LAN (http://localhost:8000/v1, a vLLM at 10.x).
# On anything reachable from the internet it turns the worker into a
# proxy into whatever network it sits on. See evalbench/core/endpoint.py.
ALLOW_PRIVATE_ENDPOINTS=false

# ── Authentication ──
# The API REFUSES TO START if SECRET_KEY / ADMIN_PASSWORD / ADMIN_API_KEY are
# left at these shipped placeholders. Set real values, or export
# EVALBENCH_ALLOW_INSECURE=1 for local dev / CI / demos.
# Generate SECRET_KEY with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-random-32-char-string
TOKEN_EXPIRE_MINUTES=10080
# EVALBENCH_ALLOW_INSECURE=1

# Default admin — created once, on first API startup, if no users exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
ADMIN_API_KEY=eb_admin_change_me_in_production

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:3000,http://localhost:3005

# ── Logging ──
LOG_LEVEL=INFO
