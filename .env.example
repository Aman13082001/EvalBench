ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
ADMIN_API_KEY=eb_admin_change_me_in_production

# CORS
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Application
LOG_LEVEL=INFO
