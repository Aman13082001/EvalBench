# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=evalbench

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Timeouts (seconds)
DEFAULT_REQUEST_TIMEOUT=120
SUITE_RUN_TIMEOUT=900

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
